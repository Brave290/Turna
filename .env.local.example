# Supabase Local Development
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-start
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-supabase-start

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# OAuth Providers (get from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email — Gmail SMTP (nodemailer) — all site emails from support.turna@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support.turna@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_EMAIL="Turna <support.turna@gmail.com>"

# Paystack (get from https://paystack.com)
# Test mode keys (default for development)

# Live mode keys (enable when going live)

# Admin / cron
ADMIN_EMAILS=
CRON_SECRET=

# Mobile
APP_API_URL=http://localhost:3000

# APK download (private repo — contents:read on Brave290/Turna)
GITHUB_TOKEN=
