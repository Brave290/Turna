# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=https://turnaapp.vercel.app
NODE_ENV=production

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email — Gmail SMTP (nodemailer) — all site emails from support.turna@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support.turna@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_EMAIL="Turna <support.turna@gmail.com>"

# Paystack (get from https://paystack.com)
# Test mode keys (default for development)
PAYSTACK_SECRET_KEY=sk_test_65b4d577d7a1e4f30b4276292ed17fcc84caa83b
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_a58519362bff30ab63f12e39f46b5dd8c9027080
PAYSTACK_PUBLIC_KEY=pk_test_a58519362bff30ab63f12e39f46b5dd8c9027080

# Live mode keys (enable when going live)
# PAYSTACK_SECRET_KEY=sk_live_your_live_key
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_live_key
# PAYSTACK_PUBLIC_KEY=pk_live_your_live_key

# Admin / cron
ADMIN_EMAILS=
CRON_SECRET=

# Mobile
APP_API_URL=http://localhost:3000

# APK download (private repo — contents:read on Brave290/Turna)
# Used by /api/download/apk to resolve the android-latest release asset.
GITHUB_TOKEN=
# Optional stable public override (e.g. Turna-Downloads latest turna.apk)
# DOWNLOADS_APK_URL=https://github.com/Brave290/Turna-Downloads/releases/latest/download/turna.apk

