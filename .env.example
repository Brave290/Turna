# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=https://turnaapp.vercel.app
NODE_ENV=production

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email — Gmail SMTP (nodemailer) — all site emails from support.turna@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support.turna@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_EMAIL="Turna <support.turna@gmail.com>"
